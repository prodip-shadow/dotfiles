{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "margin-top": 8,
    "margin-left": 14,
    "margin-right": 14,

    "modules-left": [
        "group/workspaces-island",
        "hyprland/window"
    ],

    "group/workspaces-island": {
        "orientation": "horizontal",
        "modules": [
            "custom/launcher",
            "custom/divider",
            "hyprland/workspaces"
        ]
    },
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "cpu",
        "memory",
        "backlight",
        "wireplumber",
        "bluetooth",
        "network",
        "battery",
        "custom/notification",
        "custom/keybinds",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "~/.config/rofi/launchers/type-6/launcher.sh || pkill rofi"
    },

    "custom/divider": {
        "format": "│",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "persistent-workspaces": {
            "*": 4
        },
        "on-click": "activate",
        "format": "{id} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "󰣆",
        "window-rewrite": {
            "class<.*[Bb]rave.*>": "󰖟",
            "class<.*[Ff]irefox.*>": "󰈹",
            "class<.*[Cc]hrome.*>": "",
            "class<.*[Zz]en.*>": "󰖟",
            "class<.*[Gg]hostty.*>": "󰊠",
            "class<.*[Kk]itty.*>": "󰄛",
            "class<.*[Aa]lacritty.*>": "",
            "class<.*[Cc]ode.*>": "󰨞",
            "class<.*[Vv][Ss][Cc]odium.*>": "󰨞",
            "class<.*[Aa]ntigravity.*>": "󰚩",
            "class<org.gnome.Nautilus>": "󰉋",
            "class<.*[Tt]hunar.*>": "󰉋",
            "class<org.kde.dolphin>": "󰉋",
            "class<.*[Dd]iscord.*>": "󰙯",
            "class<.*[Vv]esktop.*>": "󰙯",
            "class<org.telegram.desktop>": "",
            "class<.*[Ss]potify.*>": "",
            "class<vlc>": "󰕼",
            "class<mpv>": "",
            "class<com.obsproject.Studio>": "󰑋",
            "class<ONLYOFFICE.*>": "󰈙"
        }
    },

    "hyprland/window": {
        "max-length": 40,
        "separate-outputs": true,
        "icon": true,
        "icon-size": 16,
        "format": " {title}"
    },

    "clock": {
        "timezone": "Asia/Dhaka",
        "format": "{:%I:%M %p  ·  %a %d %b}",
        "format-alt": "{:%A, %d %B %Y  ·  %I:%M:%S %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<b>{}</b>",
                "days": "{}",
                "weeks": "<span alpha='55%'>W{}</span>",
                "weekdays": "<span alpha='65%'><b>{}</b></span>",
                "today": "<span background='#89b4fa' color='#11111b'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    },

    "cpu": {
        "interval": 3,
        "format": " {usage}%"
    },

    "memory": {
        "interval": 5,
        "format": " {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "format-icons": ["", "", ""]
    },

    "bluetooth": {
        "format": "",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias} ({device_address})",
        "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)",
        "on-click": "kill -USR2 $(cat /tmp/waybar-bt-panel.pid 2>/dev/null) 2>/dev/null || ~/.config/waybar/scripts/bluetooth-menu.py",
        "on-click-right": "blueman-manager",
        "max-length": 14
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "tooltip-format": "{ifname} · {ipaddr} ({signalStrength}%)",
        "format-linked": "󰈀 {ifname}",
        "format-disconnected": "󰤭 Offline",
        "on-click": "kill -USR2 $(cat /tmp/waybar-wifi-panel.pid 2>/dev/null) 2>/dev/null || ~/.config/waybar/scripts/wifi-menu.py",
        "on-click-right": "nm-connection-editor",
        "max-length": 14
    },

    "battery": {
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""]
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/keybinds": {
        "format": "󰌌",
        "tooltip": true,
        "tooltip-format": "Keyboard Shortcuts",
        "on-click": "~/.config/waybar/scripts/keybinds-menu.py"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "pgrep -x wlogout && pkill -x wlogout || wlogout"
    }
}

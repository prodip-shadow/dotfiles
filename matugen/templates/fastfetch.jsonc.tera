{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": {
      "keys": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "output": "38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}"
    },
    "key": { "width": 9 },
    "separator": "  ",
    "percent": {
      "type": 9,
      "color": { "green": "38;2;127;191;106", "yellow": "38;2;217;164;65", "red": "38;2;226;52;42" }
    }
  },
  "modules": [
    "break",
    { "type": "title", "format": "\u001b[1;38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{user-name}\u001b[0m\u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}m @ \u001b[0m\u001b[1;38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m{host-name}\u001b[0m" },
    "break",

    { "type": "custom", "format": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u2500\u2500\u001b[0m \u001b[1;38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}mVITALS\u001b[0m \u001b[38;2;{{colors.surface_variant.default.red}};{{colors.surface_variant.default.green}};{{colors.surface_variant.default.blue}}m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m" },
    { "type": "cpu",    "key": "CPU" },
    { "type": "gpu",    "key": "GPU", "detectionMethod": "pci" },
    { "type": "memory", "key": "MEMORY" },
    { "type": "disk",   "key": "DISK" },
    "break",

    { "type": "custom", "format": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u2500\u2500\u001b[0m \u001b[1;38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}mSYSTEM\u001b[0m \u001b[38;2;{{colors.surface_variant.default.red}};{{colors.surface_variant.default.green}};{{colors.surface_variant.default.blue}}m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m" },
    { "type": "os",      "key": "OS" },
    { "type": "host",    "key": "HOST" },
    { "type": "kernel",  "key": "KERNEL" },
    { "type": "command", "key": "WM",     "text": "echo \"${XDG_CURRENT_DESKTOP:-Hyprland}\"" },
    { "type": "command", "key": "SHELL",  "text": "basename \"${SHELL:-unknown}\"" },
    { "type": "packages","key": "PKGS" },
    "break",

    { "type": "custom", "format": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u2500\u2500\u001b[0m \u001b[1;38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}mSESSION\u001b[0m \u001b[38;2;{{colors.surface_variant.default.red}};{{colors.surface_variant.default.green}};{{colors.surface_variant.default.blue}}m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m" },
    { "type": "uptime",  "key": "UPTIME" },
    { "type": "command", "key": "AGE", "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days" },
    { "type": "terminal","key": "TERM" },
    "break",

    { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
    "break"
  ]
}

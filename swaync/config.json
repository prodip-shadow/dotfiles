{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "cssPriority": "user",

  "control-center-width": 400,
  "control-center-height": 760,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,

  "notification-window-width": 380,
  "notification-icon-size": 44,
  "notification-body-image-height": 160,
  "notification-body-image-width": 220,

  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,

  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 180,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": false,

  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰃠",
      "subsystem": "backlight"
    },
    "mpris": {
      "image-size": 64,
      "image-radius": 10
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰕾",
          "type": "toggle",
          "active": false,
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo true || echo false'"
        },
        {
          "label": "󰍬",
          "type": "toggle",
          "active": false,
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo true || echo false'"
        },
        {
          "label": "",
          "command": "sh -c 'swaync-client -cp && \"$HOME/.config/waybar/scripts/wifi-menu.py\" &'"
        },
        {
          "label": "",
          "command": "sh -c 'swaync-client -cp && \"$HOME/.config/waybar/scripts/bluetooth-menu.py\" &'"
        },
        {
          "label": "󰸉",
          "command": "sh -c 'swaync-client -cp && \"$HOME/.config/hypr/scripts/wallpaper.py\" &'"
        },
        {
          "label": "",
          "command": "sh -c 'swaync-client -cp && hyprlock &'"
        }
      ]
    }
  }
}

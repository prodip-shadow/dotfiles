@import "matugen-colors.rasi"

configuration {
    show-icons: true;
    font: "JetBrainsMono Nerd Font 10";
    disable-history: true;
    sort: false;
}

* {
    background-color: transparent;
    text-color: @fg;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    width: 980px;
    background-color: @bg;
    border: 2px solid;
    border-color: @accent;
    border-radius: 16px;
    padding: 18px;
    location: center;
    anchor: center;
}

mainbox {
    spacing: 14px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @bg-alt;
    border: 1px solid;
    border-color: @border-col;
    border-radius: 10px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder: "Search wallpapers...";
    placeholder-color: @fg-dim;
    text-color: @fg;
}

listview {
    columns: 5;
    lines: 4;
    flow: horizontal;
    fixed-height: true;
    fixed-columns: true;
    scrollbar: true;
    spacing: 12px;
}

scrollbar {
    width: 4px;
    handle-width: 4px;
    handle-color: @accent;
    border-radius: 4px;
    margin: 0px 0px 0px 8px;
}

element {
    orientation: vertical;
    padding: 10px;
    spacing: 8px;
    border-radius: 12px;
    background-color: @bg-alt;
    border: 1px solid;
    border-color: transparent;
    text-color: @fg;
}

element normal.active,
element alternate.active {
    background-color: #14532d66;
    border: 2px solid;
    border-color: #4ade80;
    text-color: #4ade80;
}

element selected.normal,
element selected.active {
    background-color: @bg-sel;
    border: 2px solid;
    border-color: @accent;
    text-color: @accent;
}

element-icon {
    size: 130px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    border-radius: 8px;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 9";
}

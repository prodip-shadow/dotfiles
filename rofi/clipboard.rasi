@import "matugen-colors.rasi"

configuration {
    show-icons: false;
    font: "JetBrainsMono Nerd Font 10";
    disable-history: true;
    sort: false;
}

* {
    background-color: transparent;
    text-color: @fg;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    width: 780px;
    background-color: @bg;
    border: 2px solid;
    border-color: @accent;
    border-radius: 16px;
    padding: 18px;
    location: center;
    anchor: center;
}

mainbox {
    spacing: 12px;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    background-color: @bg-alt;
    border: 1px solid;
    border-color: @border-col;
    border-radius: 10px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder: "Search clipboard history...";
    placeholder-color: @fg-dim;
    text-color: @fg;
    vertical-align: 0.5;
}

message {
    background-color: @bg-alt;
    border: 1px solid;
    border-color: @border-col;
    border-radius: 10px;
    padding: 8px 14px;
}

textbox {
    text-color: @fg-dim;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 9";
}

listview {
    lines: 9;
    columns: 1;
    fixed-height: false;
    scrollbar: true;
    spacing: 6px;
    margin: 2px 0px 0px 0px;
}

scrollbar {
    width: 4px;
    handle-width: 4px;
    handle-color: @accent;
    border-radius: 4px;
    margin: 0px 0px 0px 8px;
}

element,
element normal.normal,
element alternate.normal {
    padding: 10px 14px;
    border-radius: 10px;
    background-color: @bg-alt;
    border: 1px solid;
    border-color: transparent;
    text-color: @fg;
}

element selected.normal,
element selected.active {
    background-color: @bg-sel;
    text-color: @accent;
    border: 2px solid;
    border-color: @accent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 10";
}

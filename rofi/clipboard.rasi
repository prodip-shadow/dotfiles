configuration {
    show-icons: false;
    font: "FiraCode Nerd Font 11";
    disable-history: true;
    sort: false;
}

* {
    bg:          #101418ee;
    bg-alt:      #1a2028ff;
    bg-sel:      #24303dff;
    fg:          #e0e2e8ff;
    fg-dim:      #8b949eff;
    accent:      #9dcbfcff;
    border-col:  #9dcbfc66;

    background-color: transparent;
    text-color: @fg;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    width: 720px;
    background-color: @bg;
    border: 2px solid;
    border-color: @border-col;
    border-radius: 14px;
    padding: 14px;
    location: center;
    anchor: center;
}

mainbox {
    spacing: 10px;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: @accent;
    font: "FiraCode Nerd Font Bold 11";
}

entry {
    placeholder: "Search clipboard...";
    placeholder-color: @fg-dim;
    text-color: @fg;
}

message {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 7px 12px;
}

textbox {
    text-color: @fg-dim;
    horizontal-align: 0.5;
}

listview {
    lines: 10;
    columns: 1;
    fixed-height: false;
    scrollbar: true;
    spacing: 4px;
    margin: 2px 0px 0px 0px;
}

scrollbar {
    width: 4px;
    handle-width: 4px;
    handle-color: @border-col;
    border-radius: 4px;
    margin: 0px 0px 0px 6px;
}

element {
    padding: 9px 12px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-sel;
    text-color: @accent;
    border: 1px solid;
    border-color: @border-col;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

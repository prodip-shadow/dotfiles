#!/usr/bin/env bash
set -euo pipefail

# Stop Waybar and any previous ryoku-shell daemon
if pkill -x waybar 2>/dev/null || pkill -x ryoku-shell 2>/dev/null; then
    sleep 0.2
fi

export RYOKU_SHELL_DIR="/home/ashborn/.local/share/ryoku/shell"
export PATH="/home/ashborn/.local/bin:/home/ashborn/.local/share/ryoku/shell/scripts:$PATH"

# Re-map the desktop week/cava quickshell overlay after ryoku-widgets maps
# so Super+Shift+R reloads never bury the week name beneath ryoku-widgets.
(
    for _ in $(seq 1 100); do
        if hyprctl layers 2>/dev/null | grep -q "namespace: ryoku-widgets"; then
            break
        fi
        sleep 0.1
    done
    sleep 0.15
    pkill -x quickshell 2>/dev/null || true
    nohup quickshell >/dev/null 2>&1 &
) &

exec /home/ashborn/.local/bin/ryoku-shell daemon
